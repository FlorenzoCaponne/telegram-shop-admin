# ============ APP ============
APP_ENV=local                     # local | production
APP_NAME=Premium Shop
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000    # на VPS: https://domain.ru
LOG_LEVEL=INFO
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en
TIMEZONE=Europe/Moscow

# ============ TELEGRAM ============
BOT_TOKEN=
BOT_MODE=polling                  # polling (локально) | webhook (VPS)
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_SECRET=change-me-webhook-secret
ADMIN_IDS=                        # Telegram ID через запятую
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=
SUPPORT_USERNAME=
USER_AGREEMENT_URL=
PRIVACY_POLICY_URL=

# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5432/shop
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10

# ============ REDIS ============
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# ============ WEB ADMIN ============
ADMIN_PATH=/admin
ADMIN_SESSION_MAX_AGE=43200       # 12 часов
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=          # задать при первом запуске, потом сменить в админке

# ============ PAYMENTS: PLATEGA ============
PAYMENT_PROVIDER=platega          # platega | stub
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_WEBHOOK_SECRET=
PLATEGA_TEST_MODE=true
PLATEGA_SEND_METADATA=true        # передавать metadata.userId (антифрод)
PAYMENT_TTL_SECONDS=900           # 15 минут (expiresIn Platega)
PAYMENT_POLL_INTERVAL=5           # сек, фоновый опрос статуса

# ============ DOCKER COMPOSE (только для VPS) ============
# В docker compose используйте имена сервисов вместо localhost:
#   DATABASE_URL=postgresql+asyncpg://tgshop:строгий-пароль@postgres:5432/tgshop
#   REDIS_URL=redis://redis:6379/0
POSTGRES_DB=tgshop
POSTGRES_USER=tgshop
POSTGRES_PASSWORD=change-me-strong-password

# Синхронный URL только для скрипта бэкапа без Docker
DATABASE_URL_SYNC=postgresql://tgshop:change-me-strong-password@localhost:5432/tgshop
